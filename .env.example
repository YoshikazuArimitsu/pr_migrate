# .env にコピーしてトークンを設定してください（.env は git 管理しないこと）
# GitHub: Fine-grained token（Pull requests: Read/Write, Contents: Read/Write）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# 移行先も GitHub で別トークンを使う場合
# GITHUB_TOKEN_TARGET=ghp_yyyyyyyyyyyyyyyy
# Backlog: 個人設定 > API で発行
BACKLOG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
